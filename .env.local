# --- Development (same-origin via Next proxy) ---
# Browser calls /api/* which Next proxies to the Django backend, so HttpOnly
# cookies are first-party on localhost:3000.
NEXT_PUBLIC_API_BASE = /api
API_PROXY_TARGET = http://127.0.0.1:8000
# Absolute base for server-side (SSR / server action) fetches.
INTERNAL_API_BASE = http://127.0.0.1:8000/api
API_PROXY_TARGET=http://127.0.0.1:8000

# --- Production (uncomment / set in the deploy env) ---
# NEXT_PUBLIC_API_BASE = https://api.vivasense.tech/api
# INTERNAL_API_BASE = https://api.vivasense.tech/api
# (no API_PROXY_TARGET in prod — browser hits the api subdomain directly)
